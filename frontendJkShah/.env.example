NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_LOGO=
# Server-side proxy target for next.config.ts rewrites (keep unset in the client)
BACKEND_URL=http://localhost:5001
# socket.io connects directly (not proxied)
NEXT_PUBLIC_API_URL=http://localhost:5001
# Do NOT set NEXT_PUBLIC_BACKEND_URL — it bypasses the /api proxy and breaks
# HttpOnly cookie authentication (MED-02).
