# ============================================================
# QuizNew backend-mono — environment template (MED-03)
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Generate a strong JWT secret:  openssl rand -base64 64
# ============================================================

PORT=5001
# development | production
NODE_ENV=development

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jkshah_quizologist
DB_USER=postgres
DB_PASSWORD=change-me

DB_ALTER_TABLES=false
DB_DROP_TABLES=false

# --- Connection pool ---
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# --- CORS (MED-03) ---
# Development/tunnel origins are ALLOWED but trigger a startup warning when
# NODE_ENV=production. For public deployment list only your real domain(s):
#   CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5002,http://localhost:3000

# --- Redis (sessions/refresh-token store) ---
REDIS_URL=redis://localhost:6379

# --- Auth (CRIT-01) ---
# MUST be present and at least 32 characters — server refuses to start otherwise.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Tuning ---
BCRYPT_SALT_ROUNDS=10
MIN_ATTEMPTS=3
PREDEFINED_TEST_MIN_DEACTIVATE_MINUTES=5

# --- Logging (debug | info | warn | error) ---
LOG_LEVEL=info
